exports[`agent definition snapshot > matches the reviewed prompt, first message and agent body > agent body 1`] = `
{
  "conversation_config": {
    "agent": {
      "dynamic_variables": {
        "dynamic_variable_placeholders": {
          "ask_count": 0,
          "asks": "(no asks: this is an inbound call)",
          "hotline_call_id": "inbound",
          "opening": "Before anything else, what's your PIN?",
        },
      },
      "first_message": "Hey, it's your hotline. {{opening}}",
      "language": "en",
      "prompt": {
        "built_in_tools": {
          "end_call": {
            "description": "",
            "name": "end_call",
            "params": {
              "system_tool_type": "end_call",
            },
          },
        },
        "prompt": "(the prompt snapshot above)",
        "tool_ids": [
          "tool_1",
          "tool_2",
          "tool_3",
          "tool_4",
        ],
      },
    },
    "tts": {
